APP_NAME=Intel4Ops Core Platform
APP_ENV=development
# Local/disposable PostgreSQL only. Never point this example at Mobility production.
DATABASE_URL=postgresql+psycopg://intel4ops:intel4ops@localhost:5432/intel4ops
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# P3.03B AI Operational Profiler. Disabled by default and safe without a key.
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-terra
AI_API_KEY=
AI_TIMEOUT_SECONDS=20
AI_MAX_INPUT_CHARS=24000
AI_MAX_EXCERPT_CHARS=0
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_INFERENCE_ITEMS=25
AI_MAX_CLARIFICATION_QUESTIONS=10
AI_RETRY_CEILING=1
# Optional: separate disposable database used only by the PostgreSQL migration test.
# TEST_POSTGRES_URL=postgresql+psycopg://intel4ops_test:intel4ops_test@localhost:5432/intel4ops_test
# CONFIRM_DISPOSABLE_POSTGRES=1
