APP_NAME=Intel4Ops Core Platform
APP_ENV=development
# Local/disposable PostgreSQL only. Never point this example at Mobility production.
DATABASE_URL=postgresql+psycopg://intel4ops:intel4ops@localhost:5432/intel4ops
# Comma-separated explicit origin allowlist, no wildcard. If left unset:
# app_env=production yields no allowed origins (fail closed); any other
# app_env falls back to http://localhost:5173 and http://127.0.0.1:5173.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# P3.03B AI Operational Profiler. Disabled by default and safe without a key.
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-terra
AI_API_KEY=
AI_TIMEOUT_SECONDS=20
AI_MAX_INPUT_CHARS=24000
AI_MAX_EXCERPT_CHARS=0
AI_MAX_OUTPUT_TOKENS=4000
AI_NARRATIVE_MAX_INPUT_CHARS=16000
AI_NARRATIVE_MAX_OUTPUT_TOKENS=1800
AI_MAX_INFERENCE_ITEMS=25
AI_MAX_CLARIFICATION_QUESTIONS=10
AI_RETRY_CEILING=1
# Optional: separate disposable database used only by the PostgreSQL migration test.
# TEST_POSTGRES_URL=postgresql+psycopg://intel4ops_test:intel4ops_test@localhost:5432/intel4ops_test
# CONFIRM_DISPOSABLE_POSTGRES=1

# OIDC resource-server configuration (CMVP-01). Core never issues tokens and
# contains no vendor-specific code -- it only verifies bearer JWTs issued by
# whichever standards-compliant OIDC provider is configured here. All three
# values are required; get_current_user() fails closed (401/503) if any is
# missing. No secret belongs here: audience/issuer/JWKS URL are all public.
# Example values for the pilot's chosen provider (Auth0):
#   OIDC_ISSUER=https://<your-tenant>.auth0.com/
#   OIDC_AUDIENCE=<your Auth0 API identifier>
#   OIDC_JWKS_URL=https://<your-tenant>.auth0.com/.well-known/jwks.json
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALLOWED_ALGORITHMS=RS256

# P3.xxA.2 pilot auth bridge (temporary). Disabled by default and cannot
# activate when APP_ENV=production regardless of these values -- see
# app/auth/pilot_bridge.py. Never set PILOT_AUTH_TOKEN to a guessable
# string, and never enable this in a real production deployment.
# PILOT_AUTH_TOKEN is an operator-held bootstrap credential ONLY -- never
# put it in a VITE_* variable, Navigator/Lovable frontend source, a JS
# bundle, localStorage, or any other browser-visible configuration. See
# README.md "Recommended pilot security model".
PILOT_AUTH_ENABLED=false
PILOT_AUTH_TOKEN=
PILOT_USER_ID=
PILOT_PLATFORM_ADMIN=false
